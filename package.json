{
  "name": "projetv0-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.14.0",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --config vite.worker.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "start": "node .output/server/index.mjs",
    "start:worker": "node .output/worker/index.mjs",
    "test": "vitest run --maxWorkers=1",
    "test:integration": "vitest run --config vitest.integration.config.ts --maxWorkers=1",
    "test:image": "vitest run --config vitest.integration.config.ts tests/integration/web-image.test.ts --maxWorkers=1",
    "test:migrator-image": "vitest run --config vitest.integration.config.ts tests/integration/migrator-image.test.ts --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --threads=1 src/modules/marketing src/modules/sparra src/ui/marketing src/ui/sparra src/routes/app.tsx src/routes/app.index.tsx src/routes/app.entreprise.tsx src/routes/app.demandes.$requestId.tsx src/routes/index.tsx src/routes/__root.tsx src/server.ts tests/ui tests/marketing tests/integration/sparra-browser.test.ts tests/integration/marketing-browser.test.ts tests/quality-policy.test.ts",
    "test:a11y": "vitest run --config vitest.integration.config.ts tests/integration/marketing-browser.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.4",
    "@astryxdesign/theme-neutral": "0.5.4",
    "@better-auth/passkey": "1.7.4",
    "@hatchet-dev/typescript-sdk": "1.28.2",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-rc.111",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "drizzle-kit": "0.31.10",
    "nice-grpc": "2.1.17",
    "nitro": "3.0.260903-beta",
    "oxlint": "1.78.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "undici": "7.21.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
